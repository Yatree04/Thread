# Copy this file to .env and fill in your own values. Never commit .env.

# Required for real classification, summaries, and "why grouped" text.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cheap/fast model for frequent background classification calls.
# Swap for a more capable model if you want sharper grouping decisions.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Port the local API server listens on (extension talks to this).
PORT=4127

# Comma-separated folders to watch. Defaults below cover the common case.
# Use absolute paths. On Windows use forward slashes or escaped backslashes.
WATCH_DOWNLOADS=~/Downloads
WATCH_DESKTOP=~/Desktop
WATCH_SCREENSHOTS=~/Desktop

# Google Calendar OAuth client — create one at https://console.cloud.google.com/apis/credentials
# (Application type: "Desktop app"). See ../README.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
