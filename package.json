{
  "name": "trails",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dist:win": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.trails.app",
    "productName": "Trails",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/assets/*.svg"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/assets/app-icon.png",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "Trails-${version}-portable.exe"
    }
  }
}
