# Copy this file to .env and fill in your real key to enable AI clustering
# in the desktop app (electron/clustering.cjs). Get a key at:
# https://console.anthropic.com/settings/keys
#
# Without this, Trails still runs for real (real files, real clipboard, real
# tabs, real tray app, real global hotkey) — new items just land unfiled
# since there's no model deciding where they belong.
ANTHROPIC_API_KEY=
